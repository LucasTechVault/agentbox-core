{
  "name": "agentbox-core",
  "version": "0.1.0",
  "private": true,
  "description": "A local AgentBox execution kernel with bounded runs, an append-only ledger and fenced workspaces.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "demo": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
